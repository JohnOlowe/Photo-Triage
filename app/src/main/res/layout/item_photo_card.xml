<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="24dp"
    app:cardElevation="3dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardUseCompatPadding="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceContainerHigh">

        <!-- FIT_CENTER ensures wide / panoramic shots are fully visible.
             CenterCrop would hide >50% of wide images. Letterboxing with
             surfaceContainer color keeps the card elegant and on-brand. -->
        <ImageView
            android:id="@+id/imageViewPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="?attr/colorSurfaceContainerHigh"
            android:contentDescription="@string/app_name"
            tools:src="@mipmap/ic_launcher" />

        <!-- Top gradient for legibility -->
        <View
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_gradient_top" />

        <!-- Counter pill -->
        <TextView
            android:id="@+id/tvCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="14dp"
            android:background="@drawable/bg_counter_pill"
            android:elevation="2dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            tools:text="IMG_1842" />

        <!-- Bottom hint: tap to expand -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_hint_pill"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tvImageHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_tap_to_expand"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:alpha="0.95" />

        </LinearLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
