<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer">

    <damjay.photo.triage.ZoomableImageView
        android:id="@+id/ivPagerPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="photo" />

    <View
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_gradient_top"
        android:alpha="0.35" />

    <TextView
        android:id="@+id/tvTapHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_hint_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="Pinch to zoom • Double-tap • Drag to pan"
        android:textColor="#CCFFFFFF"
        android:textSize="10sp"
        android:visibility="gone" />

</FrameLayout>
